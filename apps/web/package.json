{
  "name": "@imposterio/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy --schema=../../packages/db/schema.prisma && prisma generate --schema=../../packages/db/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
