// Imposterio — Prisma Schema
//
// This database stores ONLY original Imposterio data (game votes) and the
// Federal Revenue QSA bulk import. Government data from public APIs is
// NEVER stored here — it is fetched in real time and cached in Redis.
//
// See DECISIONS.md: "No proprietary storage of government data"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Card displayed in the "Fair or not?" game.
/// Each card represents a real data point about a public official:
/// expenses, absences, attendance, bills authored, total compensation,
/// staff count, campaign donations, or wealth growth between elections.
model GameCard {
  id        String     @id @default(cuid())
  /// Card category — determines what data is shown and how the question is framed.
  /// Values: 'expense' | 'absence' | 'attendance' | 'bills_per_tenure' |
  ///         'total_compensation' | 'staff_count' | 'campaign_donations' | 'wealth_growth'
  type      String
  /// ID of the item in the original API (used for deduplication)
  sourceId  String
  /// Minimal snapshot for display and rankings.
  /// Stored fields: name, party, state, branch, value, context, photoUrl, sourceUrl
  /// Never store the full raw API response here.
  payload   Json
  createdAt DateTime   @default(now())
  votes     GameVote[]

  @@index([type])
  @@index([sourceId])
  @@map("game_cards")
}

/// A single vote cast by a user in the "Fair or not?" game.
model GameVote {
  id        String   @id @default(cuid())
  cardId    String
  card      GameCard @relation(fields: [cardId], references: [id])
  /// true = user considers this fair, false = user considers this unfair
  fair      Boolean
  createdAt DateTime @default(now())
  // IP address is NEVER stored here.
  // Flood control is handled exclusively via Redis (key: vote:{ip}:{cardId}, TTL 30 days).

  @@map("game_votes")
}

// QSA bulk import tables (company, establishment, partner, simples) are
// created dynamically by the worker at apps/worker/src/qsa-import.ts.
// See DECISIONS.md entry: "Federal Revenue QSA bulk stored in proprietary PostgreSQL"
