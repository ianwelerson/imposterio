# =============================================================================
# Imposterio — Environment Variables
# =============================================================================
# Copy this file to apps/web/.env.local and fill in your values.
# Never commit the actual .env.local file — it is already in .gitignore.
#
# All variables marked [REQUIRED] must be set for the app to run.
# Variables marked [OPTIONAL] enable additional features when set.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL via Neon)
# Used for: game_cards, game_votes, and QSA bulk import tables only.
# Get your connection string at: https://neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/imposterio    # [REQUIRED]


# -----------------------------------------------------------------------------
# CACHE (Redis via Upstash)
# Used for: caching all public API responses + game vote flood control.
# Get your credentials at: https://console.upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io         # [REQUIRED]
UPSTASH_REDIS_REST_TOKEN=your_rest_token                   # [REQUIRED]


# -----------------------------------------------------------------------------
# PORTAL DA TRANSPARÊNCIA API
# Used for: civil servants, contracts, bids, blacklists (CEIS/CNEP), travel.
# Free registration at: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Rate limits: 400 req/min (daytime), 700 req/min (overnight)
# -----------------------------------------------------------------------------
TRANSPARENCIA_API_KEY=your_api_key                         # [REQUIRED]


# -----------------------------------------------------------------------------
# CNJ / DATAJUD
# Used for: court case data, judicial productivity statistics.
# Fixed public key — always check the current value at the official wiki:
# https://datajud-wiki.cnj.jus.br/api-publica/
# This key is public and shared — it may be rotated by CNJ at any time.
# -----------------------------------------------------------------------------
DATAJUD_API_KEY=APIKey cDZHYzlZa05qU1F1SkVB            # [OPTIONAL — public key, may be outdated]


# -----------------------------------------------------------------------------
# MCP SERVERS
# Used by Claude Code MCP integrations defined in .mcp.json.
# These are NOT used by the Next.js app at runtime.
# -----------------------------------------------------------------------------

# GitHub MCP — create PRs, issues, search code
# Generate a token at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=ghp_your_personal_access_token               # [OPTIONAL — for MCP only]

# Upstash MCP — inspect Redis databases during development
# Same email and API key used for your Upstash account
# Get your API key at: https://console.upstash.com/account/api
UPSTASH_EMAIL=your@email.com                              # [OPTIONAL — for MCP only]
UPSTASH_API_KEY=your_upstash_api_key                      # [OPTIONAL — for MCP only]
